[Unit]
Description=GetException encrypted offsite backup
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/python3 /opt/getexception/current/backup.py create --install-dir /opt/getexception
TimeoutStartSec=90min
Nice=10
IOSchedulingClass=idle
