# Generate independent local values with: yarn local:env
NPM_TOKEN=
POSTGRES_PASSWORD=
MIGRATE_PASSWORD=
WEB_PASSWORD=
INGEST_PASSWORD=
WORKER_PASSWORD=
MAIL_PASSWORD=
MAIL_ENCRYPTION_KEY=
BACKUP_PASSWORD=
BETTER_AUTH_SECRET=
TOTP_ENCRYPTION_KEY=
AUTH_RATE_KEY=
SETUP_TOKEN_HASH=
DASHBOARD_HOST=monitor.localhost
INGEST_HOST=ingest.monitor.localhost
WORKER_CONCURRENCY=4
IMAGE_TAG=local
# Explicit URLs are used only when running outside Compose.
DATABASE_URL=
INTEGRATION_ADMIN_URL=

# SMTP for worker-mail; the default Compose uses local Mailpit.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_MODE=local
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=getexception@example.test
