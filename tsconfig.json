{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@getexception/browser": ["./packages/browser/src/index.ts"],
      "@getexception/react": ["./packages/react/src/index.ts"]
    }
  },
  "include": [
    "apps/ingest/src",
    "apps/worker/src",
    "apps/web/src/server",
    "packages/*/src",
    "scripts",
    "tests",
    "e2e",
    "*.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/.next"]
}
